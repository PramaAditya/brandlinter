# ==============================================================================
# brandlinter Environment Configuration
# Copy this file to .env for local development/testing.
# All keys are OPTIONAL — brandlinter works out of the box with zero keys.
# ==============================================================================

# --- SERP / SEO Collision Provider --------------------------------------------
# Auto-detection order: openserp -> searxng -> serper -> brave -> google-cse -> exa -> duckduckgo
# Set to force a specific provider: auto | openserp | searxng | serper | brave | google-cse | exa | duckduckgo
BRANDLINTER_SERP_PROVIDER=auto

# Self-hosted OpenSERP (recommended for unlimited free queries)
OPENSERP_URL=
OPENSERP_ENGINES=google
# OPENSERP_AUTH_HEADER=Bearer your-token

# Self-hosted SearXNG
SEARXNG_URL=
SEARXNG_ENGINES=google,duckduckgo

# Paid / Freemium SaaS SERP APIs (BYOK)
SERPER_API_KEY=
BRAVE_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
EXA_API_KEY=

# --- Code Hosting -------------------------------------------------------------
# Optional GitHub PAT for 5,000 req/hr & higher repo search limits.
# If unset, brandlinter will also check `gh auth token` if GitHub CLI is installed.
GITHUB_TOKEN=

# --- Domain Registrar APIs (Optional) -----------------------------------------
# By default, brandlinter uses zero-key DoH + RDAP (IANA bootstrap).
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# --- Optional Defaults --------------------------------------------------------
BRANDLINTER_COUNTRY=us
