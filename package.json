{
  "name": "brandlinter",
  "version": "0.1.0",
  "description": "Pluggable, agent-native CLI and MCP server for linting product and open-source names against SEO collisions, domains, GitHub, and package registries.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "brandlinter": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "cli",
    "brand",
    "naming",
    "seo",
    "rdap",
    "domain",
    "linter"
  ],
  "author": "Prama Aditya Putra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PramaAditya/brandlinter.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
